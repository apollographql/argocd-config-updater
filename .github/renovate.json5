{
  extends: [
    'github>apollographql/renovate-config-apollo-open-source:default.json5',
    'group:monorepos',
  ],
  // Override this value set in apollo-open-source back to the default.
  // It's nice to be able to see PRs for everything in the Dependency Dashboard.
  prCreation: 'immediate',
  schedule: 'at any time',
  dependencyDashboard: true,
  packageRules: [
    {
      // Override automerge set in apollo-open-source, as this is deployment infrastructure.
      matchUpdateTypes: ['minor', 'patch', 'pin', 'digest'],
      automerge: false,
    },
    // Bunch up all non-major dependencies into a single PR.  In the common case
    // where the upgrades apply cleanly, this causes less noise and is resolved faster
    // than starting a bunch of upgrades in parallel for what may turn out to be
    // a suite of related packages all released at once.
    {
      groupName: 'all non-major dependencies',
      matchUpdateTypes: ['patch', 'minor'],
      groupSlug: 'all-minor-patch',
    },
    // TypeScript minor versions don't follow semver, and typically require a few changes on our end to take the upgrade. Break them out from the all-minor-patch group so they don't block other upgrades.
    {
      groupName: 'typescript',
      matchPackageNames: ['typescript'],
      matchUpdateTypes: ['minor'],
    },
    // Upgrade all the major eslint things in a single PR.
    {
      matchPackageNames: [
        'eslint',
        '/^eslint-plugin/',
        '/^@typescript-eslint/',
      ],
      matchUpdateTypes: ['major'],
      groupName: 'all eslint-related major dependencies',
      groupSlug: 'all-eslint-major',
    },
    // TEMPORARY: we've fallen far behind on major upgrades, and it'll be easier to
    // catch up all at once than to work through a pile of separate major-upgrade PRs.
    // matchPackageNames: ['*'] is Renovate's documented "match everything" special case,
    // so this rule applies to (and overrides the grouping of) every dependency, bundling
    // all available upgrades of any update type into one PR.
    // separateMajorMinor: false is needed too: that setting defaults to true and takes
    // priority over packageRule grouping, so without it major updates still get split into
    // their own "major-"-prefixed branch/PR even when grouped with everything else here.
    // Remove this rule once that PR is merged, to go back to separate major-upgrade PRs.
    {
      matchPackageNames: ['*'],
      groupName: 'TEMPORARY - combine all available upgrades',
      groupSlug: 'temporary-combine-all',
      separateMajorMinor: false,
    },
  ],
  // TEMPORARY (see above): vulnerability-fix PRs ignore packageRules grouping, so fold
  // them into the same combined PR by setting groupName/groupSlug here directly too.
  // Remove this once the combined PR (above) is merged.
  vulnerabilityAlerts: {
    groupName: 'TEMPORARY - combine all available upgrades',
    groupSlug: 'temporary-combine-all',
    separateMajorMinor: false,
  },
}
